---
import { getDict, type Lang } from '../i18n';
import { SITE } from '../config/site';
import { withBase } from '../lib/url';
import StatChip, { type ChipIcon } from './StatChip.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const bgUrl = withBase('/images/quem-somos/Vista-Aerea.jpg');

const partners = SITE.sponsors.filter((s) => s.logo).length;
const stats = t.quemSomos.stats.map((s) => ({
  ...s,
  icon: s.icon as ChipIcon,
  value: s.value.replace('{partners}', String(partners)),
}));
---

<section
  id="quem-somos"
  class="relative isolate overflow-hidden bg-teal-900 text-cream py-20 md:py-28"
>
  <img
    src={bgUrl}
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="absolute inset-0 -z-10 w-full h-full object-cover object-bottom brightness-[.65] saturate-[.8]"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-teal-900/70 via-teal-900/45 to-teal-900/70"></div>

  <div data-animate="fade-up" class="relative max-w-7xl mx-auto px-4 md:px-6">
    <p class="eyebrow eyebrow-rule mb-6">{t.quemSomos.eyebrow}</p>

    <h2 class="text-4xl md:text-6xl lg:text-7xl mb-10 md:mb-14 max-w-4xl">
      <span class="block text-cream">{t.quemSomos.titleMain}</span>
      <span class="block text-gold">{t.quemSomos.titleAccent}</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-start">
      <div class="md:col-span-7 space-y-5 text-lg md:text-xl text-cream/85 leading-relaxed">
        <p>{t.quemSomos.p1}</p>
        <p>{t.quemSomos.p2}</p>
      </div>

      <div class="md:col-span-5 grid grid-cols-1 sm:grid-cols-3 md:grid-cols-1 gap-3">
        {stats.map((s) => (
          <StatChip value={s.value} label={s.label} icon={s.icon} tone="dark" />
        ))}
      </div>
    </div>
  </div>
</section>
