---
import { getDict, type Lang, locales } from '../i18n';
import { SITE } from '../config/site';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);

const links = [
  { href: '#inicio',      label: t.nav.inicio      },
  { href: '#novidades',   label: t.nav.novidades   },
  { href: '#patrocinios', label: t.nav.patrocinios },
  { href: '#quem-somos',  label: t.nav.quemSomos   },
  { href: '#direcao',     label: t.nav.direcao     },
  { href: '#contactos',   label: t.nav.contactos   },
];
---

<!--
  Transparent over the dark hero, solid cream once the page scrolls (or the
  mobile menu opens). The `data-solid` attribute is toggled by the script
  below; every colour swap hangs off `group-data-[solid]`.
-->
<header
  id="site-header"
  class="group fixed top-0 inset-x-0 z-50"
>
  <!-- Solid backdrop on its own layer so it can fade (backdrop-filter can't animate). -->
  <div
    class="absolute inset-0 bg-cream/90 backdrop-blur border-b border-ink/5 opacity-0 transition-opacity duration-400 ease-out
           group-data-[solid]:opacity-100"
    aria-hidden="true"
  ></div>

  <nav class="relative max-w-7xl mx-auto px-4 md:px-6 h-16 md:h-20 flex items-center justify-between gap-4">
    <!-- Both logos stacked in one box; they crossfade instead of swapping. -->
    <a href={withBase(`/${lang}/`)} class="relative block shrink-0 h-12 md:h-14 aspect-[415/340]" aria-label="CAIA — Spirit of Triathlon">
      <img
        src={withBase('/logo-light.png')}
        alt=""
        class="absolute inset-0 h-full w-auto transition-opacity duration-400 ease-out group-data-[solid]:opacity-0"
      />
      <img
        src={withBase('/logo.png')}
        alt="CAIA — Spirit of Triathlon"
        class="absolute inset-0 h-full w-auto opacity-0 transition-opacity duration-400 ease-out group-data-[solid]:opacity-100"
      />
    </a>

    <ul class="hidden lg:flex items-center gap-5 xl:gap-7 text-[12px] xl:text-[13px] font-semibold uppercase tracking-wider whitespace-nowrap
               text-cream/90 group-data-[solid]:text-ink transition-colors duration-400 ease-out">
      {links.map((l) => (
        <li>
          <a href={l.href} class="transition-colors duration-300 ease-out hover:text-gold group-data-[solid]:hover:text-teal">
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2 xl:gap-3 shrink-0">
      <ul class="hidden md:flex items-center gap-0.5 text-[11px] font-semibold uppercase">
        {locales.map((loc) => (
          <li>
            <a
              href={withBase(`/${loc}/`)}
              class:list={[
                'px-2 py-1 rounded transition-colors duration-400 ease-out',
                loc === lang
                  ? 'bg-gold text-ink'
                  : 'text-cream/70 hover:text-gold group-data-[solid]:text-ink/60 group-data-[solid]:hover:text-teal',
              ]}
            >
              {loc}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={SITE.socials.instagram}
        target="_blank"
        rel="noopener"
        class="hidden md:inline-flex items-center gap-1.5 rounded-full bg-gold hover:bg-gold-700 text-ink px-3.5 py-2 text-[11px] font-bold uppercase tracking-wider whitespace-nowrap transition-colors"
      >
        {t.nav.cta}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-cream group-data-[solid]:text-ink transition-colors duration-400 ease-out"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="relative lg:hidden hidden border-t border-ink/5 bg-cream">
    <ul class="px-6 py-4 space-y-3 text-sm font-semibold text-ink">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block py-1 hover:text-teal uppercase tracking-wider text-[13px]">
            {l.label}
          </a>
        </li>
      ))}
      <li class="pt-3 border-t border-ink/10 flex items-center justify-between gap-4">
        <ul class="flex items-center gap-2 text-xs font-semibold uppercase">
          {locales.map((loc) => (
            <li>
              <a
                href={withBase(`/${loc}/`)}
                class:list={[
                  'px-3 py-1.5 rounded',
                  loc === lang ? 'bg-gold text-ink' : 'text-ink/60',
                ]}
              >
                {loc}
              </a>
            </li>
          ))}
        </ul>
        <a
          href={SITE.socials.instagram}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full bg-gold text-ink px-4 py-2 text-[12px] font-bold uppercase tracking-wider"
        >
          {t.nav.cta}
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!header) return;

    const update = () => {
      const menuOpen = menu && !menu.classList.contains('hidden');
      const solid = window.scrollY > 48 || menuOpen;
      if (solid) header.setAttribute('data-solid', '');
      else header.removeAttribute('data-solid');
    };

    window.addEventListener('scroll', update, { passive: true });
    update();

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
        update();
      });
      menu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => { menu.classList.add('hidden'); update(); })
      );
    }
  })();
</script>
