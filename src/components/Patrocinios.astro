---
import { getDict, type Lang } from '../i18n';
import { SITE } from '../config/site';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);

type Slot = { logo: string | null; name: string | null; url: string | null; offsetY?: number; scale?: number };

const slotStyle = (slot: Slot) => {
  const parts = [];
  if (slot.offsetY) parts.push(`translateY(${slot.offsetY}%)`);
  if (slot.scale) parts.push(`scale(${slot.scale})`);
  return parts.length ? `transform: ${parts.join(' ')}` : undefined;
};

const logoClass = 'max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-[1.04]';
// Centred wrap: 5 per row from md (25 logos = 5 full rows), 3 per row on
// phones with the last row centred instead of leaving an orphan.
const tileBasis = 'basis-[calc((100%_-_1.5rem)/3)] md:basis-[calc((100%_-_3rem)/5)] grow-0 shrink-0';
---

<section id="patrocinios" class="bg-cream pt-8 pb-20 md:pt-14 md:pb-28">
  <div data-animate="fade-up" class="max-w-7xl mx-auto px-4 md:px-6">
    <p class="eyebrow eyebrow-rule mb-4">{t.patrocinios.eyebrow}</p>
    <h2 class="text-3xl md:text-5xl text-ink mb-3">{t.patrocinios.title}</h2>
    <p class="text-lg text-ink/70 max-w-2xl mb-12">{t.patrocinios.intro}</p>

    <div class="flex flex-wrap justify-center gap-3">
      {SITE.sponsors.map((slot) => (
        slot.logo ? (
          slot.url ? (
            <a
              href={slot.url}
              target="_blank"
              rel="noopener"
              title={slot.name ?? undefined}
              class:list={["group flex items-center justify-center h-24 md:h-28 rounded-xl bg-white ring-1 ring-ink/5 hover:shadow-md p-4 transition", tileBasis]}
            >
              <img src={withBase(slot.logo)} alt={slot.name ?? ''} class={logoClass} style={slotStyle(slot)} />
            </a>
          ) : (
            <div class:list={["group flex items-center justify-center h-24 md:h-28 rounded-xl bg-white ring-1 ring-ink/5 p-4", tileBasis]}>
              <img src={withBase(slot.logo)} alt={slot.name ?? ''} class={logoClass} style={slotStyle(slot)} />
            </div>
          )
        ) : (
          <div class:list={["flex items-center justify-center h-24 md:h-28 rounded-xl border-2 border-dashed border-ink/15 text-ink/40 text-[10px] uppercase tracking-wider", tileBasis]}>
            {t.patrocinios.espacoDisponivel}
          </div>
        )
      ))}
    </div>

    <div class="mt-14 md:mt-16 p-8 md:p-10 bg-teal-900 text-cream rounded-2xl flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <p class="text-xl md:text-2xl max-w-2xl font-bold tracking-tight">{t.patrocinios.pitch}</p>
      <a
        href="mailto:caia.triathlon.ataa@gmail.com?subject=Patrocínio%20CAIA%20Spirit%20of%20Triathlon"
        class="inline-flex items-center gap-2 bg-gold hover:bg-gold-700 text-ink font-bold px-6 py-3 rounded-full uppercase tracking-wider text-sm transition-colors shrink-0"
      >
        {t.patrocinios.cta}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
