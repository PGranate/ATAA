---
import { getDict, type Lang } from '../i18n';
import { SITE } from '../config/site';
import { withBase } from '../lib/url';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getDict(lang);

const items = SITE.novidades;
const itemCopy = t.novidades.items as Record<string, { title: string; caption: string }>;
const kindLabels = t.novidades.kinds as Record<string, string>;

const dateLocale: Record<Lang, string> = { pt: 'pt-PT', en: 'en-GB', es: 'es-ES' };
const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString(dateLocale[lang], {
    day: 'numeric', month: 'short', year: 'numeric',
  });

const badgeClass = (kind: string) => {
  switch (kind) {
    case 'upcoming': return 'bg-gold text-ink';
    case 'recap':    return 'bg-teal text-cream';
    case 'training': return 'bg-ink/80 text-cream';
    case 'news':     return 'bg-cream text-ink ring-1 ring-ink/20';
    default:         return 'bg-cream text-ink';
  }
};
---

{items.length > 0 && (
  <section id="novidades" data-animate="fade-up" class="bg-cream py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
        <div>
          <h2 class="text-4xl md:text-5xl text-ink mb-3">{t.novidades.title}</h2>
          <p class="text-lg text-ink/70 max-w-2xl">{t.novidades.intro}</p>
        </div>
        <a
          href={`https://www.instagram.com/${t.novidades.igHandle}/`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-sm font-semibold text-teal hover:text-teal-700 uppercase tracking-wider"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          {t.novidades.followCta}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {items.map((item) => {
          const copy = itemCopy[item.key];
          return (
            <a
              href={item.url}
              target="_blank"
              rel="noopener"
              class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
              <div class="relative aspect-[4/5] overflow-hidden bg-ink/5">
                <img
                  src={withBase(item.cover)}
                  alt={copy?.title ?? ''}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                />
                <span class="absolute top-3 right-3 h-8 w-8 rounded-full bg-white/95 text-ink flex items-center justify-center shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </span>
              </div>
              <div class="p-5 flex flex-col gap-2 grow">
                <div class="flex items-center justify-between gap-2">
                  <time class="text-xs uppercase tracking-wider text-ink/50">{fmtDate(item.date)}</time>
                  <span class:list={[
                    'px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider',
                    badgeClass(item.kind),
                  ]}>{kindLabels[item.kind]}</span>
                </div>
                <h3 class="text-lg font-semibold text-ink leading-snug group-hover:text-teal transition-colors">{copy?.title}</h3>
                <p class="text-sm text-ink/70 line-clamp-3 grow">{copy?.caption}</p>
                <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-teal uppercase tracking-wider">
                  {t.novidades.viewPost}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}
