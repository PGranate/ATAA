---
import { getDict, type Lang } from '../i18n';
import { SITE } from '../config/site';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);

// Two modes. With SITE.nextEvent set, the hero is the event poster (like the
// social posts). With it null, it falls back to the brand hero.
const ev = SITE.nextEvent;

const slides = ev?.image ? [{ src: ev.image, alt: ev.place }] : SITE.heroSlides;
const slideCount = slides.length;
const totalDuration = Math.max(slideCount * 8, 8);
const slideStyle = `--hero-duration: ${totalDuration}s;`;

const dateLocale: Record<Lang, string> = { pt: 'pt-PT', en: 'en-GB', es: 'es-ES' };
const fmtEventDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  let wd = d.toLocaleDateString(dateLocale[lang], { weekday: 'short' }).replace('.', '');
  wd = wd.charAt(0).toUpperCase() + wd.slice(1);
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${wd} · ${dd}.${mm}.${d.getFullYear()}`;
};

const legLabels = t.hero.event.legLabels as Record<string, string>;
---

<section id="inicio" class="relative isolate overflow-hidden min-h-[88vh] flex items-center">
  <!-- Slides -->
  <div class="absolute inset-0 -z-10">
    {slides.map((slide, i) => (
      <div
        class:list={[
          'absolute inset-0',
          slideCount > 1 ? 'hero-slide' : '',
        ]}
        style={
          slideCount > 1
            ? `${slideStyle} animation-delay: ${(i * totalDuration) / slideCount}s;`
            : ''
        }
      >
        {slide.src ? (
          <img src={withBase(slide.src)} alt={slide.alt} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-teal-700 via-teal to-teal-900"></div>
        )}
        <div class:list={[
          'absolute inset-0',
          ev
            ? 'bg-gradient-to-r from-teal-900/85 via-teal-900/60 to-teal-900/55'
            : 'bg-gradient-to-r from-teal-900/85 via-teal-900/60 to-teal-900/30',
        ]}></div>
      </div>
    ))}
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 pt-28 pb-20 md:pt-36 md:pb-28 w-full">
    <div class:list={['grid grid-cols-1 gap-12 items-center', ev && 'lg:grid-cols-12 lg:gap-10']}>

      <!-- Brand copy (unchanged) -->
      <div class:list={['max-w-2xl text-cream', ev && 'lg:col-span-7']}>
        <p class="eyebrow eyebrow-rule mb-6">
          {t.hero.eyebrow}
        </p>
        <h1 class="text-5xl md:text-6xl lg:text-7xl mb-6">
          <span class="block">{t.hero.titleMain}</span>
          <span class="block text-gold">{t.hero.titleAccent}</span>
        </h1>
        <p class="text-xl md:text-2xl text-cream/85 max-w-xl font-medium">
          {t.hero.tagline}
        </p>
      </div>

      <!-- Next-event card -->
      {ev && (
        <aside class="lg:col-span-5 lg:justify-self-end w-full max-w-sm text-cream">
          <div class="rounded-3xl border border-gold/40 bg-teal-900/70 backdrop-blur-md shadow-2xl shadow-teal-900/40 p-5 md:p-6">
            <div class="mb-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-gold text-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em]">
                <span class="h-1.5 w-1.5 rounded-full bg-ink/80"></span>
                {t.hero.event.badge}
              </span>
            </div>

            <h2 class="text-2xl md:text-[1.75rem] leading-none mb-1.5">
              <span class="text-cream">{t.hero.event.titleMain}</span>{' '}
              <span class="text-gold">{t.hero.event.titleAccent}</span>
            </h2>
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-cream/70 mb-4">
              {t.hero.event.subtitle}
            </p>

            <!-- Distances, compact -->
            <div class="grid grid-cols-3 gap-2 mb-4">
              {ev.legs.map((leg) => (
                <div class="rounded-xl border border-gold/30 bg-cream/5 px-2.5 py-2.5 flex flex-col items-start gap-1.5 min-w-0">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gold text-ink">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {leg.icon === 'swim' && <><path d="M2 17c2 0 2-1.5 4-1.5S8 17 10 17s2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5"/><path d="M4 12l5-5 5 4"/><circle cx="17" cy="7" r="2"/></>}
                      {leg.icon === 'bike' && <><circle cx="6" cy="17" r="3.5"/><circle cx="18" cy="17" r="3.5"/><path d="M6 17l4-8h5l3 8M10 9l5 8"/><circle cx="15" cy="5" r="1.5"/></>}
                      {leg.icon === 'run' && <><circle cx="14" cy="4" r="2"/><path d="M6 21l4-6 3 2 2 4"/><path d="M8 11l4-3 3 3 4-1"/><path d="M12 8l-1 6"/></>}
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <div class="text-[15px] font-extrabold tracking-tight leading-none whitespace-nowrap">{leg.value}</div>
                    <div class="mt-1 text-[9px] font-semibold uppercase tracking-[0.14em] text-cream/65 leading-tight">{legLabels[leg.label] ?? leg.label}</div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Date · time · place -->
            <ul class="space-y-2 mb-5 text-[13px]">
              <li class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold/60 text-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                </span>
                <span class="font-bold">{fmtEventDate(ev.date)}</span>
                <span class="text-cream/60">· {ev.time}</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold/60 text-gold">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span class="font-bold">{ev.place}</span>
                <span class="text-cream/60">· {ev.placeSub}</span>
              </li>
            </ul>

            <a
              href={ev.ctaUrl}
              target="_blank"
              rel="noopener"
              class="flex items-center justify-center gap-2 w-full bg-gold hover:bg-gold-700 text-ink font-bold px-5 py-3 rounded-full text-[13px] transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8 8.5 8.5 0 0 1-3.5-.75L4 21l1.75-4.5A8 8 0 1 1 21 12z"/></svg>
              {t.hero.event.cta}
            </a>
          </div>
        </aside>
      )}
    </div>
  </div>

  <a
    href="https://portugalfotografiaaerea.blogspot.com/"
    target="_blank"
    rel="noopener"
    class="absolute bottom-3 right-4 z-10 text-cream/60 hover:text-cream/90 text-[10px] md:text-xs tracking-wider transition-colors"
  >
    {t.hero.photoCredit}
  </a>
</section>
