---
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<!-- Thin closing bar. Contact details and socials live in Contactos above;
     the handle · hashtag · domain line runs in the Ticker under the hero. -->
<footer class="bg-ink text-cream/70 border-t border-cream/10">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
    <p class="text-xs text-cream/50">{t.footer.copyright}</p>
  </div>
</footer>
