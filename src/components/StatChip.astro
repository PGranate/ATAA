---
// Outlined stat chip with a gold icon square, big value and small-caps label,
// mirroring the distance/date chips on the social posts.
export type ChipIcon = 'calendar' | 'clock' | 'pin' | 'people' | 'handshake' | 'swim' | 'bike' | 'run';

interface Props {
  value: string;
  label: string;
  icon?: ChipIcon;
  tone?: 'dark' | 'light';
}
const { value, label, icon, tone = 'dark' } = Astro.props;
---

<div
  class:list={[
    'flex items-center gap-4 rounded-2xl border px-5 py-4',
    tone === 'dark' ? 'border-gold/40 bg-cream/5' : 'border-ink/10 bg-white',
  ]}
>
  {icon && (
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-gold text-ink">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {icon === 'calendar' && <><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></>}
        {icon === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
        {icon === 'pin' && <><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></>}
        {icon === 'people' && <><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 15.5a5 5 0 0 1 5 4.5"/></>}
        {icon === 'handshake' && <><path d="M2 12l4-4 4 3 3-3 4 4"/><path d="M6 8l-2 4 3 3 3 3a2 2 0 0 0 3 0l4-4"/><path d="M14 8l2-2 6 6-3 3"/></>}
        {icon === 'swim' && <><path d="M2 17c2 0 2-1.5 4-1.5S8 17 10 17s2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5"/><path d="M4 12l5-5 5 4"/><circle cx="17" cy="7" r="2"/></>}
        {icon === 'bike' && <><circle cx="6" cy="17" r="3.5"/><circle cx="18" cy="17" r="3.5"/><path d="M6 17l4-8h5l3 8M10 9l5 8"/><circle cx="15" cy="5" r="1.5"/></>}
        {icon === 'run' && <><circle cx="14" cy="4" r="2"/><path d="M6 21l4-6 3 2 2 4"/><path d="M8 11l4-3 3 3 4-1"/><path d="M12 8l-1 6"/></>}
      </svg>
    </span>
  )}
  <div class="min-w-0">
    <div class:list={['text-2xl md:text-3xl font-extrabold tracking-tight leading-none', tone === 'dark' ? 'text-cream' : 'text-ink']}>
      {value}
    </div>
    <div class:list={['mt-1.5 text-[11px] font-semibold uppercase tracking-[0.18em]', tone === 'dark' ? 'text-cream/70' : 'text-ink/60']}>
      {label}
    </div>
  </div>
</div>
